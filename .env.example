APP_ENV=development
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/finsight
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/finsight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finsight

# Redis
REDIS_URL=redis://redis:6379/0

# Supabase Auth
SUPABASE_URL=https://mock.supabase.co
SUPABASE_ANON_KEY=mock-anon-key
SUPABASE_JWT_SECRET=development-secret-for-jwt-signing-finsight-min-32-chars

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=mock-llm-key

# Jev / TypeSafe AI
JEV_API_KEY=mock-jev-key
JEV_MODEL=jev-v1

# Observability
LANGSMITH_API_KEY=mock-langsmith-key
LANGSMITH_PROJECT=finsight
LANGSMITH_TRACING=false

# Object Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=finsight
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://mock.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key
