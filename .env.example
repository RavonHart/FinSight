APP_ENV=development
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/finsight
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/finsight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finsight

# Redis
REDIS_URL=redis://redis:6379/0

# Supabase Auth
SUPABASE_URL=https://mock.supabase.co
SUPABASE_ANON_KEY=mock-anon-key
SUPABASE_JWT_SECRET=development-secret-for-jwt-signing-finsight-min-32-chars

# LLM Configuration (OpenAI, Gemini, etc.)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-openai-api-key-here
# Optional direct alias (either LLM_API_KEY or OPENAI_API_KEY is accepted):
OPENAI_API_KEY=your-openai-api-key-here

# Jev / TypeSafe AI Configuration
JEV_API_KEY=your-jev-api-key-here
JEV_MODEL=jev-v1
JEV_BASE_URL=https://api.typesafe.ai/v1

# Observability
LANGSMITH_API_KEY=mock-langsmith-key
LANGSMITH_PROJECT=finsight
LANGSMITH_TRACING=false

# Object Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=finsight
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://mock.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key
